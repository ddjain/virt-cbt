# Required for cluster operations. Use an explicit readable file path; the validator does not infer oc's default.
KUBECONFIG=
# Use a unique name on a shared cluster. The validator creates and owns only this namespace.
NAMESPACE=cbt-demo
VM_COUNT=1
VM_PREFIX=fedora-cbt
VM_LABEL_SELECTOR=app.kubernetes.io/name=odf-cbt-validator
CONTAINER_IMAGE=quay.io/containerdisks/fedora:41
VM_CPU=1
VM_MEMORY=1Gi
DATA_SIZE=10Gi
BACKUP_SIZE=20Gi
# Select ODF RBD-compatible classes. Discover names with: oc get storageclass
DATA_STORAGE_CLASS=ocs-storagecluster-ceph-rbd
BACKUP_STORAGE_CLASS=ocs-storagecluster-ceph-rbd
TARGET_NODE=
# make generate-keys creates this key pair when absent; SSH_PUBLIC_KEY is derived from SSH_KEY.pub.
SSH_KEY=keys/cbt-validator
SSH_PUBLIC_KEY=
SSH_USER=fedora
TIMEOUT=600
STABILIZE_TIMEOUT=300
CBT_CHANGE_WAIT=5
REPORTS_DIR=reports
# Forensic diagnostics around each Full/Incremental backup (CR YAML +
# controller/handler/launcher logs). Set to 0 to disable. Depth: core|storage.
CBT_DIAGNOSTICS=1
CBT_DIAGNOSTICS_DEPTH=core
# Used by make cbt-restore-proof and make cbt-cycle / density marker seeding
# (baseline write MiB, then append MiB before Incremental). Also sizes the
# /data/vm-validator/cbt-marker.bin created at density-setup cloud-init.
# Sized large enough that Full/Incremental take long enough for chaos injection mid-backup.
RESTORE_PROOF_BASE_MIB=512
RESTORE_PROOF_APPEND_MIB=128
